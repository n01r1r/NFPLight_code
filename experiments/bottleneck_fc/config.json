{
  "schema_version": 1,
  "experiment_id": "bottleneck_fc_probe",
  "output": {
    "default_directory": "artifacts/bottleneck_fc_probe"
  },
  "dataset": {
    "manifest": "C:/MatSynth_PRIMA_Fabric/manifests/fabric_leather_training_manifest.jsonl",
    "shard_path_base": "repo_root",
    "train_split": "train",
    "heldout_split": "val",
    "categories": [
      "Fabric",
      "Leather"
    ],
    "materials_per_category": 4,
    "train_crops": [
      0,
      8
    ],
    "unseen_crop": 4,
    "heldout_crop": 4,
    "crops_per_shard": 16,
    "cache_shards": 4,
    "map_keys": [
      "normal",
      "diffuse",
      "roughness",
      "specular"
    ],
    "diffuse_decode_gamma": 2.2,
    "normal_decode": "uint8/127.5-1 then unit normalize",
    "roughness_decode": "uint8/255",
    "specular_target": 0.04
  },
  "model": {
    "backbone": {
      "name": "TwoBranchNet",
      "width": 32,
      "middle_blocks": 4,
      "encoder_blocks": [
        2,
        2,
        4
      ],
      "decoder_blocks": [
        2,
        2,
        2
      ],
      "input_channels": 21,
      "output_channels": 10,
      "input_resolution": 256
    },
    "bottleneck": {
      "channels": 256,
      "side": 32,
      "normalization": "LayerNorm2d",
      "residual_gate_initial": 0.0,
      "spatial_fc_hidden": 32,
      "pixel_mlp_hidden": 128
    },
    "baseline_parameters": 7609834,
    "expected_parameters": {
      "baseline": 7609834,
      "bottleneck_fc": 7741932,
      "pixel_mlp": 7741932
    },
    "arms": [
      {
        "id": "baseline",
        "label": "baseline",
        "operator": "identity",
        "color": "#333333"
      },
      {
        "id": "bottleneck_fc",
        "label": "baseline+Bottleneck_FC",
        "operator": "per_channel_shared_spatial_fc",
        "color": "#0072b2"
      },
      {
        "id": "pixel_mlp",
        "label": "baseline+Pixel_MLP",
        "operator": "per_pixel_channel_mlp",
        "color": "#e69f00"
      }
    ]
  },
  "sampling": {
    "batch_size": 4,
    "uniform_selection": "manifest-order evenly spaced indices; not loss-guided",
    "sample_order": "Python random.Random(seed+sample_order_seed_offset), paired across arms",
    "sample_order_seed_offset": 10000,
    "d4_augmentation": false
  },
  "training": {
    "seeds": [
      7,
      19,
      31
    ],
    "map_updates": 1000,
    "render_updates": 300,
    "map_learning_rate": 0.0005,
    "render_learning_rate": 0.0001,
    "learning_rate_schedule": "constant within each stage",
    "adam_betas": [
      0.9,
      0.999
    ],
    "fresh_adam_at_render_stage": true,
    "gradient_clip_norm": 1.0,
    "render_loss_weight": 1.0,
    "checkpoint_interval": 100,
    "evaluation_interval": 100
  },
  "loss": {
    "map_terms": [
      "unit_xyz_normal_l1",
      "diffuse_rgb_l1",
      "roughness_l1"
    ],
    "map_aggregation": "equal_mean",
    "normal_degrees": "evaluation_only",
    "invalid_or_nonfinite": "fail"
  },
  "rendering": {
    "feature_version": "raw_calibrated_gain9_v3",
    "precision": "float32",
    "amp": false,
    "tf32": false,
    "near_distance": 4.0,
    "far_distance": 12.0,
    "gain": 9.0,
    "f0": 0.04,
    "training_lights": {
      "radius": 4.0,
      "theta_degrees": [
        5,
        10,
        20,
        30,
        45
      ],
      "phi_degrees": [
        0,
        45,
        90,
        135,
        180,
        225,
        270,
        315
      ],
      "view": [
        0.0,
        0.0,
        2.75
      ]
    },
    "novel_lights": {
      "radius": 4.0,
      "theta_degrees": [
        12,
        27,
        40
      ],
      "phi_degrees": [
        22.5,
        112.5,
        202.5,
        292.5
      ],
      "view": [
        0.0,
        0.0,
        2.75
      ]
    }
  },
  "runtime": {
    "device": "cuda",
    "torch_num_threads": 4,
    "cudnn_deterministic": true,
    "cudnn_benchmark": false
  },
  "provenance": {
    "identity_method": "resolved path, file size, and mtime_ns; no content hashes",
    "source_files": [
      "experiments/bottleneck_fc/config.py",
      "experiments/bottleneck_fc/models.py",
      "experiments/bottleneck_fc/pipeline.py",
      "experiments/bottleneck_fc/run.py",
      "experiments/bottleneck_fc/manage.py",
      "experiments/bottleneck_fc/report.py",
      "model/nfplight_model.py",
      "model/relation_geometry.py",
      "network/nfplight_net.py",
      "network/base_net.py",
      "data/fabric.py",
      "utils/render_util.py",
      "utils/__init__.py",
      "capture_processing/difference_visualization.py"
    ]
  }
}
